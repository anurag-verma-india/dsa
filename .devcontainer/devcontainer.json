// For format details, see https://aka.ms/devcontainer.json. For config options, see the
// README at: https://github.com/devcontainers/templates/tree/main/src/cpp
{
    "name": "C++9.3.0",
    "build": {
        "dockerfile": "Dockerfile"
    },

    // Features to add to the dev container. More info: https://containers.dev/features.
    // "features": {},

    // Use 'forwardPorts' to make a list of ports inside the container available locally.
    // "forwardPorts": [],

    // Use 'postCreateCommand' to run commands after the container is created.
    // "postCreateCommand": "gcc -v",

    // Configure tool-specific properties.
    "customizations": {
        "vscode": {
            // C++ function code block start curly brace on the same line as the function
            "C_Cpp.clang_format_fallbackStyle": "{ BasedOnStyle: Google, IndentWidth: 4, ColumnLimit: 0}",
            "settings": {
                "code-runner.executorMap": {
                    "c": "cd $dir && gcc $fileName -o $fileNameWithoutExt.bin && $dir$fileNameWithoutExt.bin",
                    "cpp": "cd $dir && g++ -O2 -Wall $fileName -o $fileNameWithoutExt && $dir$fileNameWithoutExt"
                },
                "vim.handlekeys": {
                    "<C-w>": false
                },
                "editor.formatOnSave": true,
                "git.autofetch": true,
                "[json]": {
                    "editor.defaultFormatter": "esbenp.prettier-vscode"
                }
            },
            "extensions": [
                "formulahendry.code-runner",
                "streetsidesoftware.code-spell-checker",
                "vscodevim.vim",
                "ms-vscode.cpptools-extension-pack"
            ]
        }
    }

    // Uncomment to connect as root instead. More info: https://aka.ms/dev-containers-non-root.
    // "remoteUser": "root"
}
